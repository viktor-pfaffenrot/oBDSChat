LLM_PROVIDER=requesty
OPENAI_MODEL=gpt-5.6-terra
LLM_API_KEY_SOURCE=config/secrets/llm_api_key.txt
LLM_API_KEY_FILE=/run/secrets/llm_api_key
OBDSCHAT_BASE_DIR=/app
OBDSCHAT_INIT_DATA=./db
OBDSCHAT_DB_DATA_DIR=./data/obdschat_db/data
OBDSCHAT_DB_LOG_DIR=./data/obdschat_db/logs
OBDSCHAT_DB_HOST=db
OBDSCHAT_DB_PORT=5432
OBDSCHAT_DB_PUBLISHED_PORT=55434
OBDSCHAT_DB_NAME=obdschat
OBDSCHAT_DB_USER=obdschat
OBDSCHAT_DB_PASSWORD_SOURCE=config/secrets/obdschat_db_password.txt
OBDSCHAT_DB_PASSWORD_FILE=/run/secrets/obdschat_db_password
OBDSCHAT_BACKEND_PORT=18000
OBDSCHAT_FRONTEND_PORT=17860
OBDSCHAT_DOCS_PORT=8000
OBDSCHAT_QUERY_CONCURRENCY=8
POSTGRES_USER=obdschat
POSTGRES_PASSWORD_FILE=/run/secrets/obdschat_db_password
POSTGRES_DB=obdschat
TZ=Europe/Berlin
