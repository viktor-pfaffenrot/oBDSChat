d1\" ac:local-id=\"2bebcf1d-2718-4e0a-a9a8-c5c3bbf233f9\"><p local-id=\"17898d4cc300\"><strong>NI</strong></p></td><td data-highlight-colour=\"#abf5d1\" ac:local-id=\"90fc9346-9757-4d4d-9d68-d5548773bac8\"><p local-id=\"e5deb70d835c\"><strong>NW</strong></p></td><td data-highlight-colour=\"#abf5d1\" ac:local-id=\"dd29b841-0a9e-43c4-aa52-b8d2165aa413\"><p local-id=\"a385bae8d1fc\"><strong>RP</strong></p></td><td data-highlight-colour=\"#abf5d1\" ac:local-id=\"41226d37-8c90-47ea-b2dd-5956ffc96d5b\"><p local-id=\"aafe3722d7b4\"><strong>SL</strong></p></td><td data-highlight-colour=\"#f4f5f7\" ac:local-id=\"752d74cf-1962-4ef9-9039-b15202f0342b\"><p local-id=\"ff507a302e7f\"><em>SN</em></p></td><td data-highlight-colour=\"#abf5d1\" ac:local-id=\"78f8fb85-55cf-49a3-8508-76cd42e15013\"><p local-id=\"d3d9b519a9d9\"><strong>ST</strong></p></td><td data-highlight-colour=\"#abf5d1\" ac:local-id=\"dade8486-a014-4d87-9d1c-b032a3376b5c\"><p local-id=\"bc68f8b42ffd\"><strong>SH</strong></p></td><td data-highlight-colour=\"#abf5d1\" ac:local-id=\"511e10fb-1e46-4f8b-9869-b1de55a3b93a\"><p local-id=\"29d4b7f4549e\"><strong>TH</strong></p></td></tr></tbody></table><ac:structured-macro ac:name=\"expand\" ac:schema-version=\"1\" data-layout=\"wide\" ac:local-id=\"21f854af-4091-42a1-9a27-d79683204ec5\" ac:macro-id=\"104c4e0d-cccc-4385-a3af-cf128e8c43e6\"><ac:parameter ac:name=\"title\">Legende</ac:parameter><ac:parameter ac:name=\"breakoutWidth\">1800</ac:parameter><ac:rich-text-body><table data-table-width=\"1438\" data-layout=\"align-start\" ac:local-id=\"010045f9-ed14-40fe-8f1f-051da02b1d7f\"><colgroup><col style=\"width: 1376.0px;\" /></colgroup><tbody><tr ac:local-id=\"948b1c2c-9606-47c8-b7c4-1cebb46ec21c\"><td data-highlight-colour=\"#abf5d1\" ac:local-id=\"99949000-fedf-414d-8a06-ddbd005080d2\"><p local-id=\"4735f57fbe37\"><strong>Die Seite ist vom Landeskrebsregister positiv validiert worden und ist f&uuml;r das Landeskrebsregister g&uuml;ltig.</strong></p></td></tr><tr ac:local-id=\"edeaa0d8-f656-4b20-b11b-516d4f3a25ae\"><td data-highlight-colour=\"#fff0b3\" ac:local-id=\"c4df1be9-7089-4a1b-8827-695d2f68319c\"><p local-id=\"17a1b52dcf5d\"><strong>Die Seite ist vom Landeskrebsregister positiv validiert worden. Es sind L&auml;nderspezifika zu beachten, die unten erg&auml;nzend vom Landeskrebsregister angegeben worden sind.</strong></p></td></tr><tr ac:local-id=\"9bf1d8be-5b34-4fb9-913a-3c7a8f10925f\"><td data-highlight-colour=\"#ffbdad\" ac:local-id=\"fac84928-f569-4a1f-9e96-a3251257f5eb\"><p local-id=\"c554ec4d22f6\"><del>Die Seite ist vom Landeskrebsregister negativ validiert worden. Im Text sind unten Erl&auml;uterungen erg&auml;nzt, warum die Beschreibung f&uuml;r das entsprechende Landeskrebsregister nicht passt.</del></p></td></tr><tr ac:local-id=\"2cdfad0b-2b9d-45e8-bb8d-323c47cf891c\"><td data-highlight-colour=\"#f4f5f7\" ac:local-id=\"36f0ff17-5314-419e-b7fc-37bb99f899fb\"><p local-id=\"4a7b2bf483ce\"><em>Die Seite ist vom Landeskrebsregister noch nicht &uuml;berpr&uuml;ft worden.</em></p></td></tr></tbody></table></ac:rich-text-body></ac:structured-macro><ac:adf-extension><ac:adf-node type=\"panel\"><ac:adf-attribute key=\"panel-type\">note</ac:adf-attribute><ac:adf-attribute key=\"local-id\">3a85900a-90f4-4dd0-ae0c-b16a7e89f327</ac:adf-attribute><ac:adf-content><p local-id=\"f715ba09fcba\"><strong>Hinweis: &Auml;nderungen zur vorherigen Version sind in der Markierungsfarbe <span style=\"background-color: rgb(198,237,251);\">T&uuml;rkis</span> hervorgehoben.</strong></p></ac:adf-content></ac:adf-node><ac:adf-fallback><div class=\"panel conf-macro output-block\" style=\"background-color: rgb(234,230,255);border-color: rgb(153,141,217);border-width: 1.0px;\"><div class=\"panelContent\" style=\"background-color: rgb(234,230,255);\">\n<p local-id=\"f715ba09fcba\"><strong>Hinweis: &Auml;nderungen zur vorherigen Version sind in der Markierungsfarbe <span style=\"background-color: rgb(198,237,251);\">T&uuml;rkis</span> hervorgehoben.</strong></p>\n</div></div></ac:adf-fallback></ac:adf-extension><h1 local-id=\"66cd62470e36\">Allgemeines</h1><p local-id=\"88887bb45308\"><span style=\"background-color: rgb(198,237,251);\">Die Diagnosemeldung umfasst detaillierte Informationen zur vorliegenden Tumorerkrankung und zum</span> <ac:link><ri:page ri:content-title=\"Allgemeiner Leistungszustand\" ri:version-at-save=\"24\" /><ac:link-body><span style=\"background-color: rgb(198,237,251);\">allgemeinen Leistungszustand</span></ac:link-body></ac:link> <span style=\"background-color: rgb(198,237,251);\">des Patienten/der Patientin</span>.</p><p local-id=\"c17c37f8a6a0\"><span style=\"background-color: rgb(198,237,251);\">Angaben zur</span> <a href=\"https://plattform65c.atlassian.net/wiki/spaces/Dokumentat/pages/75366493/Diagnosemeldung#Merkmale-und-Auspr%C3%A4gungen\"><span style=\"background-color: rgb(198,237,251);\">Diagnose und zur Diagnosesicherung</span></a>  <span style=\"background-color: rgb(198,237,251);\">(s. folgende Tabelle &ldquo;Merkmale und Auspr&auml;gungen&rdquo;) werden erg&auml;nzt durch die genaue Bezeichnung von</span> </p><ul local-id=\"d06bbe35-4bfe-4144-8d6f-6eac981debcb\"><li local-id=\"c7503301-259b-413f-a07b-18585b44a616\"><p local-id=\"c26053e41672\"><ac:link><ri:page ri:content-title=\"Histologie\" ri:version-at-save=\"119\" /><ac:link-body>Tumorhistologie</ac:link-body></ac:link></p></li><li local-id=\"f773e33f-e1f1-4c8b-90a4-78c905398233\"><p local-id=\"8c1842bbd122\"><ac:link><ri:page ri:content-title=\"TNM und Stadium\" ri:version-at-save=\"88\" /><ac:link-body>TNM und Stadium</ac:link-body></ac:link></p></li><li local-id=\"47172120-6919-40d2-9654-d47a03dedd47\"><p local-id=\"d6c33a8366f8\"><ac:link><ri:page ri:content-title=\"Fernmetastasen\" ri:version-at-save=\"62\" /><ac:link-body>Fernmetastasen</ac:link-body></ac:link></p></li><li local-id=\"7284e0c9-9dfc-47a2-b7c8-11b2e1fbf265\"><p local-id=\"804bceb88bc1\"><ac:link><ri:page ri:content-title=\"Weitere Klassifikationen\" ri:version-at-save=\"58\" /><ac:link-body>Weitere Klassifikationen</ac:link-body></ac:link></p></li><li local-id=\"b7a28273-0140-49d9-bd39-6544ef6e947b\"><p local-id=\"028795833321\">weiteren Angaben (<ac:link><ri:page ri:content-title=\"Modul: Allgemein\" ri:version-at-save=\"33\" /><ac:link-body>Modul Allgemein</ac:link-body></ac:link>)</p></li><li local-id=\"967518d1-4de3-481d-b6b8-696077276093\"><p local-id=\"9d9eeb82c683\">Parametern in den entit&auml;tsspezifischen Modulen (<ac:link><ri:page ri:content-title=\"Modul: Kolorektales Karzinom\" ri:version-at-save=\"67\" /><ac:link-body>Kolorektales Karzinom</ac:link-body></ac:link>, <ac:link><ri:page ri:content-title=\"Modul: Malignes Melanom\" ri:version-at-save=\"35\" /><ac:link-body>Malignes Melanom</ac:link-body></ac:link>, <ac:link><ri:page ri:content-title=\"Modul: Mammakarzinom\" ri:version-at-save=\"68\" /><ac:link-body>Mammakarzinom</ac:link-body></ac:link>, <ac:link><ri:page ri:content-title=\"Modul: Prostatakarzinom\" ri:version-at-save=\"37\" /><ac:link-body>Prostatakarzinom</ac:link-body></ac:link>).</p></li></ul><p local-id=\"30a56781cf32\">In zunehmendem Ma&szlig;e gewinnen auch <ac:link><ri:page ri:content-title=\"Genetische Varianten\" ri:version-at-save=\"52\" /><ac:link-body>Biomarker und genetische Marker</ac:link-body></ac:link> an Bedeutung [1].</p><h1 local-id=\"3016b384990f\">Merkmale und Auspr&auml;gungen</h1><table data-table-width=\"1800\" data-layout=\"center\" ac:local-id=\"c6b83ece-9832-4bfe-be2c-c55c58df58a4\"><colgroup><col style=\"width: 177.0px;\" /><col style=\"width: 329.0px;\" /><col style=\"width: 432.0px;\" /><col style=\"width: 862.0px;\" /></colgroup><tbody><tr ac:local-id=\"e1a85384-4a6a-4d25-a55e-ee9c22d143c2\"><th ac:local-id=\"cf4f35d7-bc7a-4711-804a-a925cf22f0d6\"><p local-id=\"f172f6a447fd\"><strong>ID (oBDS)</strong></p></th><th ac:local-id=\"6bffb1f3-4eba-455f-af10-a5dc39f7cf42\"><p local-id=\"8e50d867532d\"><strong>Merkmal</strong></p></th><th ac:local-id=\"475faebf-4706-4296-a5a2-3c6d6e88cf32\"><p local-id=\"366d243db22c\"><strong>Auspr&auml;gungen</strong></p></th><th ac:local-id=\"b0203b9f-f464-4d2e-b2ef-b7a141ce2d6a\"><p local-id=\"4da23b7cd39d\"><strong>Beschreibung</strong></p></th></tr><tr ac:local-id=\"94d97e8f-b4c4-402b-b243-39a45f495730\"><td ac:local-id=\"ca66dada-5f67-4c8b-856a-e1319d850a29\"><p local-id=\"978fbb99906e\">05.01</p></td><td ac:local-id=\"bd0f5470-3ef2-4878-b309-024761595163\"><p local-id=\"8f31e53eb6e9\">Prim&auml;rtumor Tumordiagnose ICD- Code</p></td><td ac:local-id=\"eb91b478-48f6-4416-be68-4218a5faf059\"><p local-id=\"db09ae31ae2b\">Alphanumerischer Code</p></td><td ac:local-id=\"e4f09868-32ad-47a8-9d89-0d1cfcc3652e\"><p local-id=\"d8da5658bbeb\">siehe <ac:link><ri:page ri:content-title=\"Tumorzuordnung\" ri:version-at-save=\"46\" /><ac:link-body>Tumorzuordnung</ac:link-body></ac:link></p><p local-id=\"5ab1d28980e8\" /></td></tr><tr ac:local-id=\"f75e0819-aa82-496d-831f-93eb28e55309\"><td ac:local-id=\"ed895028-886b-4de9-b715-0ba70fc8bf82\"><p local-id=\"6c3ed1ebcecb\">05.02</p></td><td ac:local-id=\"177b80ba-34a8-4eb5-8d60-f105ee145366\"><p local-id=\"734c2f6c1af6\">Prim&auml;rtumor Tumordiagnose ICD-Version</p></td><td ac:local-id=\"6d9ac520-7e4c-4192-82e4-e0c997d9f5b5\"><p local-id=\"189b08d666d3\"><ac:link ac:local-id=\"581ad39c-c553-44be-a4ce-1d22f5b9bf5b\" ac:card-appearance=\"inline\"><ri:page ri:space-key=\"UMK\" ri:content-title=\"G&uuml;ltige Versionsangaben f&uuml;r medizinische Klassifikationen\" ri:version-at-save=\"8\" /><ac:link-body>G&uuml;ltige Versionsangaben f&uuml;r medizinische Klassifikationen</ac:link-body></ac:link> </p></td><td ac:local-id=\"b7d14c9a-242e-45cc-8ae1-df1235ab0e11\"><p local-id=\"0e6726fd1b20\">verwendete <a href=\"https://www.bfarm.de/DE/Kodiersysteme/Klassifikationen/ICD/ICD-10-GM/_node.html\">ICD-10-GM-Version</a></p><p local-id=\"23c50770b94e\">Hinweis: Es ist die zum Diagnosezeitpunkt aktuelle Version zu verwenden (entsprechend der im Diagnosejahr geltenden ICD-Version).</p></td></tr><tr ac:local-id=\"3902e7b9-576d-4073-a49c-bd91d215fa03\"><td ac:local-id=\"66ee8dff-a8aa-4a4a-b466-974287b79564\"><p local-id=\"16d1f82c3c1d\">05.03</p></td><td ac:local-id=\"0a9e60fb-7f36-4e8a-8d04-38dfd9c1d539\"><p local-id=\"77b30106a280\">Prim&auml;rtumor Tumordiagnose Text</p></td><td ac:local-id=\"26abce57-a296-4fea-aa5f-cbe138f832b2\"><p local-id=\"96f24af309b5\">Freitext</p></td><td ac:local-id=\"5b1eceec-d441-49dc-b379-e54bca04a5d5\"><p local-id=\"aa3c1265736b\">Bezeichnung der meldepflichtigen Erkrankung nach ICD-10-GM <span style=\"background-color: rgb(198,237,251);\">[2]</span></p></td></tr><tr ac:local-id=\"d7a677be-22af-4817-a470-c5411dd74215\"><td ac:local-id=\"e58681df-1834-4bfe-acc2-4820813e5fee\"><p local-id=\"07ef5e83498f\">05.04</p></td><td ac:local-id=\"01a6129d-dc4a-4183-8d27-1da4b8591029\"><p local-id=\"2aa2b9f1f486\">Prim&auml;rtumor Topographie ICD-O</p></td><td ac:local-id=\"ed0ffcd8-2b46-496e-87b4-8dea7ea1b21e\"><p local-id=\"24708144ece8\">Alphanumerischer Code</p></td><td ac:local-id=\"f7efc6b7-3588-4cd9-87ce-dbe135890c6a\"><p local-id=\"44da5ece2463\">Topographie (= Lokalisation) einer Erkrankung nach der aktuellen <a href=\"https://www.bfarm.de/DE/Kodiersysteme/Klassifikationen/ICD/ICD-O-3/_node.html\">ICD-O-Version</a> <span style=\"background-color: rgb(198,237,251);\">[3]</span></p><p local-id=\"fcf4f3eec990\" /></td></tr><tr ac:local-id=\"a1b5361e-7e4b-4087-af55-43d0ae1c7ece\"><td ac:local-id=\"cd541dc4-5c86-4089-a201-cf006d5d11db\"><p local-id=\"a0b855c38b23\">05.05</p></td><td ac:local-id=\"e972beb7-ff79-4232-be9b-f7ecd48d5fcd\"><p local-id=\"2f62ea51e18b\">Prim&auml;rtumor Topographie ICD-O-Version</p></td><td ac:local-id=\"cf4ab358-f036-4d83-9269-8bd418dd81b6\"><p local-id=\"9afb53eed9bc\"><ac:link ac:local-id=\"13618a43-ae8a-4ce4-87c7-8ed9ded10a5a\" ac:card-appearance=\"inline\"><ri:page ri:space-key=\"UMK\" ri:content-title=\"G&uuml;ltige Versionsangaben f&uuml;r medizinische Klassifikationen\" ri:version-at-save=\"8\" /><ac:link-body>G&uuml;ltige Versionsangaben f&uuml;r medizinische Klassifikationen</ac:link-body></ac:link> </p></td><td ac:local-id=\"99c4d64f-fef7-47b2-8c41-2f8cb3e36c00\"><p local-id=\"75dd831a45f9\">verwendete ICD-O-Version</p><p local-id=\"54912960440c\">Hinweis: Es ist die zum Diagnosezeitpunkt aktuelle Version zu verwenden<br />(aktuell: ICD-O-3, Zweite Revision 2019).</p></td></tr><tr ac:local-id=\"ff2a9af2-2d26-4b63-98dd-85ad1665b834\"><td ac:local-id=\"4f5aae33-d4f7-407e-a5a2-61ac93d5779c\"><p local-id=\"1fb3f8951050\">05.06</p></td><td ac:local-id=\"52600c72-8065-46c8-b0b3-1b10b44b3a20\"><p local-id=\"844f00615f89\">Prim&auml;rtumor Diagnosedatum</p></td><td ac:local-id=\"ec408884-0945-4e7a-bd02-64a1c0f92449\"><p local-id=\"ced0ba343cdb\">TT.MM.JJJJ</p></td><td ac:local-id=\"60128ebf-f771-4185-8101-91c4d866b7f0\"><p local-id=\"9e1f39965084\">siehe <ac:link><ri:page ri:content-title=\"Tumorzuordnung\" ri:version-at-save=\"46\" /><ac:link-body>Tumorzuordnung</ac:link-body></ac:link></p></td></tr><tr ac:local-id=\"8f28458e-09cd-406b-ab74-ea34b5c66df4\"><td ac:local-id=\"2f481086-a19b-4052-98a2-ffc24f71232f\"><p local-id=\"8ab93287e31a\">05.07</p></td><td ac:local-id=\"8353ac37-d986-4fa5-b71f-4e41ea53465c\"><p local-id=\"74a88aa9c50f\">Prim&auml;rtumor Diagnosesicherung</p><p local-id=\"b7a4281aa918\" /></td><td ac:local-id=\"13c396b6-c122-4697-8658-cd138abdfcac\"><p local-id=\"ff731ff1b7f1\"><span style=\"color: rgb(151,160,175);\">0 = nur Todesbescheinigung (DCO)</span><br />1  = klinisch<br />2  = klinische Diagnostik<br />4  = spezifische Tumor-Marker<br />5  = Zytologie</p><p local-id=\"42a41f9f1829\" /><p local-id=\"6ccef64cca03\">7.1  = Histologie des Prim&auml;rtumors<br />7.2  = Histologie einer Metastase<br />7.3  = Histologie der Autopsie</p><p local-id=\"21020d1c2896\">8     = zytogenetisch und/oder molekularer Test<br /><span style=\"color: rgb(151,160,175);\">9     = unbekannt</span></p></td><td ac:local-id=\"96273336-26c1-40ef-9cb7-8cca891572ac\"><p local-id=\"8b4f95b9d4e4\"><span style=\"background-color: rgb(198,237,251);\">Das Merkmal &ldquo;Prim&auml;rtumor Diagnosesicherung&rdquo;</span> <span style=\"background-color: rgb(198,237,251);\">gibt an, wie</span> die Diagnose gesichert werden konnte. Es<span style=\"background-color: rgb(198,237,251);\"> sagt etwas &uuml;ber die Verl&auml;sslichkeit der spezifischen Diagnose aus und wird gem&auml;&szlig; ENCR als Grad der Diagnosesicherung bezeichnet.</span> </p><p local-id=\"ec0061279d0e\">Der Grad der Diagnosesicherung soll gem&auml;&szlig; der <a href=\"https://encr.eu/sites/default/files/Recommendations/ENCR%20Recommendation%20BoD_Oct2022_DE_052025.pdf\">ENCR-Empfehlung von 2022</a> <span style=\"background-color: rgb(198,237,251);\">angegeben</span> werden. [4]</p><p local-id=\"6d41ec4760b0\">Weitere <span style=\"background-color: rgb(198,237,251);\">Erl&auml;uterungen zu den Codes und ihren Anwendungsregeln</span> siehe Tabelle <a href=\"https://plattform65c.atlassian.net/wiki/spaces/Dokumentat/pages/75366493/Diagnosemeldung#Grad-der-Diagnosesicherung-gem%C3%A4%C3%9F-ENCR-Empfehlung-%5B4%5D\">Grad der Diagnosesicherung</a>  <span style=\"background-color: rgb(198,237,251);\">gem&auml;&szlig; ENCR-Empfehlung.</span></p><p local-id=\"64e8b05b2305\" /></td></tr><tr ac:local-id=\"e4db9f05-0ec7-4c1e-b697-2edbcd07fa6c\"><td ac:local-id=\"8c12992b-5e68-4901-8b50-c74ebc99cedd\"><p local-id=\"ee907c234067\">05.08</p></td><td ac:local-id=\"bb024593-5161-4651-99c1-7f0466bb76fc\"><p local-id=\"2313d21ccc35\">Prim&auml;rtumor Seitenlokalisation</p></td><td ac:local-id=\"fd1977d8-ea83-45e0-9a9f-33d7b81e19f5\"><p local-id=\"e05ea2399a74\">L = links<br />R = rechts<br />B = beidseitig<br />M = Mittellinie/mittig<br />U = unbekannt<br />T = trifft nicht zu</p></td><td ac:local-id=\"15a42cd2-b6a0-4a50-9352-f86c207b6ac8\"><p local-id=\"4a585c30ec79\">siehe <ac:link><ri:page ri:content-title=\"Tumorzuordnung\" ri:version-at-save=\"46\" /><ac:link-body>Tumorzuordnung</ac:link-body></ac:link></p></td></tr><tr ac:local-id=\"dcbf14ba-19ae-4052-b622-fe92fbb4091c\"><td ac:local-id=\"b2413c13-e764-4d59-91d2-9e344f149329\"><p local-id=\"93f1012ce7b7\">05.09</p></td><td ac:local-id=\"e5abc1dc-3f24-4cd6-aed2-e2cd28e83ef7\"><p local-id=\"0706000db760\">Fr&uuml;here Tumorerkrankungen</p></td><td ac:local-id=\"c1cb6b59-03c4-4126-b8ce-f6944a337497\"><p local-id=\"d66aea74176d\">Freitext oder ICD-10-GM-Code mit Angabe des Diagnosejahres (JJJJ)</p></td><td ac:local-id=\"d964cb6f-6aab-49aa-855e-a32a7b86ce1e\"><p local-id=\"e2432e50ad15\">Anamnestisch vorbekannte, fr&uuml;here Tumorerkrankungen mit Angabe des Diagnosejahres; ausformulierte Diagnose oder verschl&uuml;sselt nach ICD-10-GM</p></td></tr></tbody></table><h1 local-id=\"9afea69bcf2c\">Grad der Diagnosesicherung gem&auml;&szlig; ENCR-Empfehlung [4] </h1><ac:structured-macro ac:name=\"expand\" ac:schema-version=\"1\" data-layout=\"wide\" ac:local-id=\"62551445-56df-4264-a514-a4178752fd4b\" ac:macro-id=\"c024f6e8-74af-4c27-858a-13a20bf3ea33\"><ac:parameter ac:name=\"title\">Tabelle: Grad der Diagnosesicherung gem&auml;&szlig; ENCR-Empfehlung [4]</ac:parameter><ac:parameter ac:name=\"breakoutWidth\">1800</ac:parameter><ac:rich-text-body><table data-layout=\"default\" ac:local-id=\"912a4fc2-a518-4a23-88ed-ca61752f4b7c\"><colgroup><col style=\"width: 304.0px;\" /><col style=\"width: 469.0px;\" /><col style=\"width: 603.0px;\" /></colgroup><tbody><tr ac:local-id=\"7ae286e1-9cf9-4520-92dd-93b2ca1a08ab\"><td data-highlight-colour=\"#deebff\" ac:local-id=\"7424da14-2ded-4a5b-b471-fe6ad628d689\"><p local-id=\"7eff7cf56f42\"><strong><span style=\"background-color: rgb(198,237,251);\">Grad der Diagnosesicherung</span></strong></p></td><td data-highlight-colour=\"#deebff\" ac:local-id=\"abbed1ad-4a07-49ea-b07e-38b04b996887\"><p local-id=\"a30612921b47\"><strong><span style=\"background-color: rgb(198,237,251);\">Beschreibung und Kriterien</span></strong></p></td><td data-highlight-colour=\"#deebff\" ac:local-id=\"1b21bcce-28db-4104-897b-3513a6198461\"><p local-id=\"6ddfc8875380\"><strong><span style=\"background-color: rgb(198,237,251);\">Regeln und Erl&auml;uterungen</span></strong></p></td></tr><tr ac:local-id=\"53e75492-1d2b-4685-b06c-8f0e29a18d41\"><td ac:local-id=\"c576a900-70a9-478c-b50b-463cffaa8aaf\"><p local-id=\"5443e51e5830\"><span style=\"color: rgb(151,160,175);\"><del>0<sup>1</sup></del></span></p></td><td ac:local-id=\"22c8e5c8-ffd3-46cf-8db3-3686cae891b7\"><p local-id=\"e8439ae770ef\"><em><span style=\"background-color: rgb(198,237,251);\">&ldquo;Nur Todesbescheinigung (DCO): Die Information wurde durch eine Todesbescheinigung bereitgestellt (Death Certificate Only, DCO).&rdquo;</span></em></p></td><td ac:local-id=\"4e957421-5ec9-41f5-ada1-ac7632e33066\"><p local-id=\"1016057ec8be\" /></td></tr><tr ac:local-id=\"13254868-130f-44ca-a58c-a86ffe216756\"><td ac:local-id=\"4bd24225-be28-470f-9c8d-843e664a519c\"><p local-id=\"5a435f8a886b\">1</p></td><td ac:local-id=\"cbce6306-0eef-41a0-8f23-5080725ec50e\"><p local-id=\"a4bcdf528df1\"><em><strong><span style=\"background-color: rgb(198,237,251);\">&ldquo;Klinisch</span></strong><span style=\"background-color: rgb(198,237,251);\">: Diagnosestellung vor dem Tod, jedoch ohne eine der folgenden Untersuchungen (Codes 2-8)&rdquo;</span></em></p></td><td ac:local-id=\"ea742682-ad91-4e2b-87e0-96a2a73fe1bc\"><p local-id=\"1efda9d6ec8d\"><em><span style=\"background-color: rgb(198,237,251);\">&ldquo;Code 1 soll nur f&uuml;r Krebserkrankungen verwendet werden, die ausschlie&szlig;lich durch k&ouml;rperliche Untersuchung (vor der Autopsie) nachgewiesen werden. &hellip;</span></em></p><p local-id=\"e6d520a41027\"><em><span style=\"background-color: rgb(198,237,251);\">&hellip; Es ist nahezu unm&ouml;glich, Krebserkrankungen der meisten inneren Organe (wie Lunge, Magen, Kolon oder Niere) ausschlie&szlig;lich durch k&ouml;rperliche Untersuchung zu diagnostizieren, auch wenn seltene Ausnahmen m&ouml;glich sind.&rdquo;</span></em></p></td></tr><tr ac:local-id=\"3369fab5-b833-4fd1-8370-a282e29c731a\"><td ac:local-id=\"dbf72d43-b161-4c2e-ae1b-e940f1a3ab1d\"><p local-id=\"daa715785ecd\">2</p></td><td ac:local-id=\"e9b38e18-2124-4bde-a65e-8589f6c36652\"><p local-id=\"1ec48c38c2b9\"><em><strong><span style=\"background-color: rgb(198,237,251);\">&ldquo;Klinische Untersuchung</span></strong><span style=\"background-color: rgb(198,237,251);\">: Alle diagnostischen Verfahren, einschlie&szlig;lich R&ouml;ntgen, Endoskopie, bildgebender Verfahren, Ultraschall, explorativer Eingriffe (wie Laparotomie) und Autopsie, ohne Gewebsuntersuchung.&rdquo;</span></em></p></td><td ac:local-id=\"a2375901-1e7f-4a37-8c4a-2eb9557fa481\"><p local-id=\"4fd7af47c765\" /></td></tr><tr ac:local-id=\"89244078-bb72-4bf7-a3da-76d633f5fbc4\"><td ac:local-id=\"906e68c4-d3eb-48bc-8c73-4d80e62cbb15\"><p local-id=\"32263ac5ea66\">4</p></td><td ac:local-id=\"5f7f8e21-634e-4843-a74b-13f875b09ef5\"><p local-id=\"d3ed9e560615\"><em><strong><span style=\"background-color: rgb(198,237,251);\">&ldquo;Spezifische Tumormarker</span></strong><span style=\"background-color: rgb(198,237,251);\">: Einschlie&szlig;lich biochemischer und/oder immunologischer Marker, die f&uuml;r eine bestimmte Tumorlokalisation spezifisch sind.&rdquo;</span></em></p></td><td ac:local-id=\"2ff43604-b580-451f-8236-62742e60b4c0\"><p local-id=\"766432bdbdd0\"><em><span style=\"background-color: rgb(198,237,251);\">&ldquo;Code 4 (spezifische Tumormarker) ist immer in Verbindung mit einer klinischen Krebsdiagnose und/oder einer klinischen Untersuchung, die auf Krebs hinweist, zu verwenden, da viele Tumormarker, zum Beispiel Prostataspezifisches Antigen (PSA), auch bei Nichtvorliegen einer Krebserkrankung erh&ouml;ht sein k&ouml;nnen.</span></em></p><p local-id=\"08bf90a71f1c\"><em><span style=\"background-color: rgb(198,237,251);\">Die Krebserkrankungen, die mit Diagnosesicherung Code 4 registriert werden k&ouml;nnen, sind in </span></em><a href=\"https://www.encr.eu/sites/default/files/Recommendations/ENCR%20Recommendation%20BoD_Oct2022_DE_052025.pdf\"><em><span style=\"background-color: rgb(198,237,251);\">Tabelle 4</span></em></a><em><span style=\"background-color: rgb(198,237,251);\"> aufgef&uuml;hrt.&rdquo;</span></em><br /><em><span style=\"background-color: rgb(198,237,251);\">[Anmerkung der Redaktion: s. Tab. 4 in der </span></em><a href=\"https://www.encr.eu/sites/default/files/Recommendations/ENCR%20Recommendation%20BoD_Oct2022_DE_052025.pdf\"><em><span style=\"background-color: rgb(198,237,251);\">ENCR-Empfehlung</span></em></a><em><span style=\"background-color: rgb(198,237,251);\">] </span></em></p></td></tr><tr ac:local-id=\"4ccb0162-4f7e-4b56-9041-83291fd62f26\"><td ac:local-id=\"27708b15-22f8-4434-99d4-8a484a02e336\"><p local-id=\"1ce5882f0715\">5</p></td><td ac:local-id=\"f20c2584-22c5-49c6-857d-a25f1b1da5dc\"><p local-id=\"e0d2d14dd2ef\"><em><strong><span style=\"background-color: rgb(198,237,251);\">&ldquo;Zytologie</span></strong><span style=\"background-color: rgb(198,237,251);\">: Untersuchung von Zellen aus einer prim&auml;ren oder sekund&auml;ren Lokalisation, einschlie&szlig;lich der aus durch Endoskopie oder Punktion gewonnen Aspiraten; beinhaltet auch die mikroskopische Untersuchung peripheren Blutes und von Knochenmarkspunktaten, Immunph&auml;notypisierung durch Durchflusszytometrie<sup>2</sup> und eine Liquid Biopsy<sup>3</sup> bei Fehlen eines histopathologischen Befundes.&rdquo;</span></em></p></td><td ac:local-id=\"b0bec480-9109-436c-a972-24a828b6c100\"><p local-id=\"d05cef51e9d1\"><em><span style=\"background-color: rgb(198,237,251);\">&ldquo;Wird eine f&uuml;r Krebserkrankungen spezifische genetische Anomalie oder Ver&auml;nderung mittels &lsquo;Liquid&rsquo; Biopsy entdeckt (bei klinischer Krebsdiagnose, aber fehlendem pathologischem Nachweis), ist Diagnosesicherung Code 5 anzuwenden.&rdquo;</span></em></p><p local-id=\"88e97f4f1c27\" /></td></tr><tr ac:local-id=\"49fd4819-1451-42a5-9e49-0525388b97ce\"><td ac:local-id=\"c1b84258-448a-421f-a676-1f0df967cbcb\"><p local-id=\"a969dce5e9e1\">7</p></td><td ac:local-id=\"8d64d179-6f53-43fb-b540-aee3383ec541\"><p local-id=\"5be73349fa8d\"><em>&nbsp;&ldquo;<strong><span style=\"background-color: rgb(198,237,251);\">Histologie</span></strong><span style=\"background-color: rgb(198,237,251);\">: Histologische Untersuchung von Tumorgewebe (prim&auml;r oder metastatisch), gleich wie es gewonnen wurde; einschlie&szlig;lich aller Schnitttechniken und Knochenmarksbiospien; schlie&szlig;t auch die Untersuchung von Proben des Prim&auml;rtumors aus einer Autopsie ein. &hellip;</span></em><br /><em><strong><span style=\"background-color: rgb(198,237,251);\">7.1 Histologie des Prim&auml;rtumors</span></strong><span style=\"background-color: rgb(198,237,251);\">: Histologische Untersuchung von Gewebe des Prim&auml;rtumors, unabh&auml;ngig von der Art der Gewinnung, einschlie&szlig;lich aller Schnitttechniken und Knochenmarksbiopsien.</span></em><br /><em><strong><span style=\"background-color: rgb(198,237,251);\">7.2 Histologie der Metastase<sup>4</sup></span></strong><span style=\"background-color: rgb(198,237,251);\">: Histologie der Metastase ohne Histologie des Prim&auml;rtumors</span></em><br /><em><strong><span style=\"background-color: rgb(198,237,251);\">7.3 Histologie der Autopsie</span></strong><span style=\"background-color: rgb(198,237,251);\">: Histologie der Autopsie ohne Histologie vor der Autopsie&rdquo;</span></em></p></td><td ac:local-id=\"eeec0295-ccff-4161-b6f4-35902eb96383\"><p local-id=\"ac50a24c64d7\" /></td></tr><tr ac:local-id=\"8bed4dd3-b9e1-4baa-8a7a-1144ada56900\"><td ac:local-id=\"c41e0ac1-fce5-43b2-bd79-42b67ddef666\"><p local-id=\"e0388874985a\">8<sup>5</sup></p></td><td ac:local-id=\"f9cc7eb8-f83a-4ab2-9c3f-916f1ff16dba\"><p local-id=\"0caf8cd06481\"><em><strong><span style=\"background-color: rgb(198,237,251);\">&ldquo;Zytogenetisch und/oder molekularer Test</span></strong><span style=\"background-color: rgb(198,237,251);\">: Nachweis von tumorspezifischen genetischen Anomalien oder genetischen Ver&auml;nderungen im Tumor einschlie&szlig;lich Verfahren wie Karyotypisierung, FISH (Fluoreszenz-in-situ-Hybridisierung), PCR (Polymerase Kettenreaktion).&rdquo;</span></em></p></td><td ac:local-id=\"08f0d190-b716-4fa2-a283-215a9002c7cc\"><p local-id=\"128d3a0da302\"><em><span style=\"background-color: rgb(198,237,251);\">&ldquo;Viele Tumoren weisen genetische Anomalien oder Ver&auml;nderungen auf. Nur wenige sind spezifisch f&uuml;r die Diagnose bestimmter Krebserkrankungen. Nur wenn die genetische Anomalie oder Ver&auml;nderung spezifisch f&uuml;r eine solche Krebserkrankung ist, soll Diagnosesicherung Code 8 angewendet werden. In den meisten F&auml;llen sollte die Anomalie oder Ver&auml;nderung vorliegen (z.B. Chronisch myeloische Leuk&auml;mie CML, BCR-ABL1 positiv ist 9875/3), aber es gibt auch Krebsdiagnosen, die durch das Fehlen einer genetischen Anomalie oder Ver&auml;nderung gekennzeichnet sind (z.B. Glioblastom IDH-Wildtyp ist 9440/3). Diagnosesicherung Code 8 trifft auf beide Beispiele zu.&rdquo;<sup>3</sup></span></em></p></td></tr><tr ac:local-id=\"8ee8d1f0-449d-4ca5-a5c7-14caf948da8b\"><td ac:local-id=\"0aad8a99-e6a6-455c-a475-f7f234d85bef\"><p local-id=\"ec01aa63c531\"><span style=\"color: rgb(151,160,175);\"><del>9<sup>6</sup></del></span></p></td><td ac:local-id=\"d0abe17d-7cbe-499d-9e11-d1435c0832d0\"><p local-id=\"34e9a55cdb47\"><em><span style=\"color: rgb(151,160,175);\">&ldquo;Unbekannt&rdquo;</span></em></p></td><td ac:local-id=\"70c4e8a6-a9b4-4ffd-9a48-bcb8f817d3b7\"><p local-id=\"654f60500ab5\" /></td></tr></tbody></table><p local-id=\"1f7c0b2a9ea8\"><sup>1</sup><strong>Diagnosesicherung <span style=\"background-color: rgb(198,237,251);\">Code</span> 0</strong> <span style=\"background-color: rgb(198,237,251);\">wird nicht erwartet</span>, weil <span style=\"background-color: rgb(198,237,251);\">nur f&uuml;r </span>DCO-Meldungen <span style=\"background-color: rgb(198,237,251);\">zutreffend</span>, <span style=\"background-color: rgb(198,237,251);\">welche</span> das Register<span style=\"background-color: rgb(198,237,251);\"> nicht</span> &uuml;ber <span style=\"background-color: rgb(198,237,251);\">den oBDS</span> erreichen.</p><p local-id=\"b853ca2dc393\"><sup>2&rdquo;</sup><em><span style=\"background-color: rgb(198,237,251);\">Durchflusszytometrie wird oft zur Diagnose von Leuk&auml;mien und Lymphomen verwendet, z.B. chronisch lymphatische Leuk&auml;mie.</span></em><span style=\"background-color: rgb(198,237,251);\">&rdquo; [4]</span></p><p local-id=\"a84deaad6568\"><sup>3&rdquo;</sup><em><span style=\"background-color: rgb(198,237,251);\">eine Liquid Biopsy ist eine Blutprobe oder eine Probe einer anderen K&ouml;rperfl&uuml;ssigkeit (Liquor, etc.) zum Nachweis von Krebszellen oder DNA-Fragmenten dieser Tumorzellen</span></em><span style=\"background-color: rgb(198,237,251);\">&rdquo; [4]</span></p><p local-id=\"ecc65b190fdf\"><span style=\"background-color: rgb(198,237,251);\"><sup>4</sup></span><strong><span style=\"background-color: rgb(198,237,251);\">Diagnosesicherung Code 7.2</span></strong><span style=\"background-color: rgb(198,237,251);\">: Die ENCR erl&auml;utert den Begriff &ldquo;Metastase&rdquo; in dieser Empfehlung nicht n&auml;her und stellt auch keinen Bezug zur TNM-Klassifikation her. Daher ist davon auszugehen, dass unter dem Begriff &ldquo;Metastase&rdquo; hier jegliche Metastasen zu verstehen sind, d.h. bezogen auf die TNM-Klassifikation</span> <span style=\"background-color: rgb(198,237,251);\">sowohl Fernmetastasen als auch region&auml;re Lymphknoten-Metastasen.</span></p><p local-id=\"0915ede10b42\"><sup>5</sup><strong><span style=\"background-color: rgb(198,237,251);\">Diagnosesicherung Code 8</span></strong><span style=\"background-color: rgb(198,237,251);\">: Der </span><a href=\"https://encr.eu/sites/default/files/Recommendations/Data%20quality%20checks%20for%20validation%20of%20the%20ECIS%20database_20251124.pdf\"><strong><span style=\"background-color: rgb(198,237,251);\">ECIS Technical Report</span></strong></a><span style=\"background-color: rgb(198,237,251);\"> gibt eine Reihe von Morphologie-Codes an, f&uuml;r die Diagnosesicherung Code 8 anwendbar ist, s. Abschnitt 3.1.3 und Tab.4 im ECIS Technical Report [5]. Die Tab. erhebt keinen Anspruch auf Vollst&auml;ndigkeit.</span></p><p local-id=\"59307f738682\"><sup>6</sup><strong>Diagnosesicherung <span style=\"background-color: rgb(198,237,251);\">Code</span> 9</strong> <span style=\"background-color: rgb(198,237,251);\">wird nicht erwartet, da</span> bei &Uuml;bermittlung einer gesicherten Diagnose <span style=\"background-color: rgb(198,237,251);\">der</span> Grad <span style=\"background-color: rgb(198,237,251);\">der Diagnosesicherung als bekannt vorausgesetzt werden darf.</span></p></ac:rich-text-body></ac:structured-macro><p local-id=\"b181081cafe4\" /><h2 local-id=\"db982f148e32\">Weitere Merkmale und Module</h2><ul local-id=\"e6645762-9d25-40a2-9249-3dbb19113b75\"><li local-id=\"c7e81c87-a205-4aff-af0e-40054299f936\"><p local-id=\"fcd658f683e0\"><ac:link><ri:page ri:content-title=\"Histologie\" ri:version-at-save=\"119\" /><ac:link-body>Histologie</ac:link-body></ac:link></p></li><li local-id=\"4ed8f45b-36a9-424b-8511-8d4b78339080\"><p local-id=\"49d57e640ad0\"><ac:link><ri:page ri:content-title=\"TNM und Stadium\" ri:version-at-save=\"88\" /><ac:link-body>TNM und Stadium</ac:link-body></ac:link></p></li><li local-id=\"634001cd-3cbf-483e-96c9-40751265bb8f\"><p local-id=\"7fdbb3843b1d\"><ac:link><ri:page ri:content-title=\"Weitere Klassifikationen\" ri:version-at-save=\"58\" /><ac:link-body>Weitere Klassifikationen</ac:link-body></ac:link></p></li><li local-id=\"00fee715-9e1c-45bf-a1d7-4810c4867a04\"><p local-id=\"7f5bc1973d31\"><ac:link><ri:page ri:content-title=\"Fernmetastasen\" ri:version-at-save=\"62\" /><ac:link-body>Fernmetastasen</ac:link-body></ac:link></p></li><li local-id=\"a916f52f-895e-4f12-8269-5b2d1042f758\"><p local-id=\"5ed7a1b6249a\"><ac:link><ri:page ri:content-title=\"Allgemeiner Leistungszustand\" ri:version-at-save=\"24\" /><ac:link-body>Allgemeiner Leistungszustand</ac:link-body></ac:link></p></li><li local-id=\"e61108a1-5f31-4a92-95f5-558039e2d0e2\"><p local-id=\"d138653ef644\"><ac:link><ri:page ri:content-title=\"Genetische Varianten\" ri:version-at-save=\"52\" /><ac:link-body>Genetische Varianten</ac:link-body></ac:link></p></li><li local-id=\"f2340a8f-a976-4a8a-9b16-d6c7549e7408\"><p local-id=\"d4a353977198\"><ac:link><ri:page ri:content-title=\"Modul: Allgemein\" ri:version-at-save=\"33\" /><ac:link-body>Modul: Allgemein</ac:link-body></ac:link></p></li><li local-id=\"3bf527f1-aa25-4d82-9d05-1ca7da35a90b\"><p local-id=\"68063fd5cf23\"><ac:link><ri:page ri:content-title=\"Modul: Kolorektales Karzinom\" ri:version-at-save=\"67\" /><ac:link-body>Modul: Darm</ac:link-body></ac:link></p></li><li local-id=\"f96dd503-8f67-451a-8618-176d171fbc4c\"><p local-id=\"20b12a85686c\"><ac:link><ri:page ri:content-title=\"Modul: Malignes Melanom\" ri:version-at-save=\"35\" /><ac:link-body>Modul: Malignes Melanom</ac:link-body></ac:link></p></li><li local-id=\"95b2ecda-d771-45f8-9898-7a79818769b5\"><p local-id=\"c6738211323a\"><ac:link><ri:page ri:content-title=\"Modul: Mammakarzinom\" ri:version-at-save=\"68\" /><ac:link-body>Modul: Mamma</ac:link-body></ac:link></p></li><li local-id=\"d4060a5b-f9b5-43f4-92f5-7fafe7838b8b\"><p local-id=\"106a02602229\"><ac:link><ri:page ri:content-title=\"Modul: Prostatakarzinom\" ri:version-at-save=\"37\" /><ac:link-body>Modul: Prostata</ac:link-body></ac:link></p></li></ul><table data-table-width=\"1800\" data-layout=\"center\" ac:local-id=\"2f0c66b2-36de-4b99-a50a-c24252c3552e\"><tbody><tr ac:local-id=\"4b367465-d918-4e48-858b-409e5b1e5407\"><th ac:local-id=\"0b6b4240-ce18-44c8-ab7d-fbc11cc9cdae\"><p local-id=\"23c5efcd522c\"><strong>Quellen</strong></p></th></tr><tr ac:local-id=\"dd99e3ea-8ba1-4336-8477-b57d93aa9e03\"><td ac:local-id=\"c6f74d48-d0ab-4d74-83ac-d98440812961\"><p local-id=\"df8f348a3506\">[1] DKFZ. (13.02.2025)<a href=\"https://www.krebsinformationsdienst.de/untersuchungen-bei-krebs/diagnose-und-befunde-bedeutung#c8521\" local-id=\"fe1359c1-20fc-4526-93e4-16ca983b26b1\" data-card-appearance=\"inline\">https://www.krebsinformationsdienst.de/untersuchungen-bei-krebs/diagnose-und-befunde-bedeutung#c8521</a> </p></td></tr><tr ac:local-id=\"fb94effd-14c1-46f7-a522-da70ca6f7080\"><td ac:local-id=\"64a0b448-20bc-4474-9411-9b294d575080\"><p local-id=\"c8cbda83a950\">[2] BfArM. ICD-10-GM, Internationale statistische Klassifikation der Krankheiten und verwandter Gesundheitsprobleme, 10. Revision, German Modification. Bundesinstitut f&uuml;r Arzneimittel und Medizinprodukte; <a href=\"https://www.bfarm.de/DE/Kodiersysteme/Klassifikationen/ICD/ICD-10-GM/_node.html\" local-id=\"49784360-3058-41e8-be1c-87c299f1f75a\" data-card-appearance=\"inline\">https://www.bfarm.de/DE/Kodiersysteme/Klassifikationen/ICD/ICD-10-GM/_node.html</a>  </p></td></tr><tr ac:local-id=\"19a8a33c-f96e-4883-99c8-9aa934627e1b\"><td ac:local-id=\"516944cf-1c25-4dce-9c0e-156f9bcf8ff5\"><p local-id=\"0735438ada36\">[3] BfArM. ICD-O-3, Internationale Klassifikation der Krankheiten f&uuml;r die Onkologie, Dritte Ausgabe. Bundesinstitut f&uuml;r Arzneimittel und Medizinprodukte <a href=\"https://www.bfarm.de/DE/Kodiersysteme/Klassifikationen/ICD/ICD-O-3/_node.html\" local-id=\"87b62693-67e6-465a-9cc4-17ef1310933a\" data-card-appearance=\"inline\">https://www.bfarm.de/DE/Kodiersysteme/Klassifikationen/ICD/ICD-O-3/_node.html</a>  </p></td></tr><tr ac:local-id=\"017bfc30-ed97-4a98-8170-24f9bc23d618\"><td ac:local-id=\"6b8ea511-d1ac-4ea7-8e23-a554aed1b817\"><p local-id=\"8f9318667d6d\">[4] ENCR. ENCR-Empfehlung: Grad der Diagnosesicherung; Oktober 2022 <a href=\"https://www.encr.eu/sites/default/files/Recommendations/ENCR%20Recommendation%20BoD_Oct2022_DE_052025.pdf\">Grad der Diagnosesicherung</a></p></td></tr><tr ac:local-id=\"26ce5150-7c33-44d9-8fdd-b22fda1a22ea\"><td ac:local-id=\"9a091ef7-f1ac-43b0-9fc2-9271affe64c0\"><p local-id=\"e2f28e346e2e\">[5] ECIS. Data quality checks for validation of the ECIS database; November 2025, Version 1.0 <a href=\"https://encr.eu/sites/default/files/Recommendations/Data%20quality%20checks%20for%20validation%20of%20the%20ECIS%20database_20251124.pdf\">ECIS Technical report</a></p></td></tr><tr ac:local-id=\"2d5eaf70-a321-4eb3-992c-5c2f2d10b08a\"><td ac:local-id=\"52e98a77-443d-4c88-8f05-c33be42a31ab\"><p local-id=\"715460ea2348\" /></td></tr></tbody></table><p local-id=\"2557cf41d7ce\" />"
